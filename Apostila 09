-- CRIAÇÃO DAS OPERAÇÕES
CREATE OR REPLACE FUNCTION subtracao(n1 INT, n2 INT)
RETURNS INT AS $$
BEGIN
    RETURN n1 - n2;
END;
$$ LANGUAGE plpgsql

CREATE OR REPLACE FUNCTION soma(n1 INT, n2 INT)
RETURNS INT AS $$
BEGIN
    RETURN n1 + n2;
END;
$$ LANGUAGE 

CREATE OR REPLACE FUNCTION divisao(n1 INT, n2 INT)
RETURNS FLOAT AS $$
BEGIN
    RETURN n1 / n2;
END;
$$ LANGUAGE plpgsql

CREATE OR REPLACE FUNCTION multiplicacao(n1 INT, n2 INT)
RETURNS INT AS $$
BEGIN
    RETURN n1 * n2;
END;
$$ LANGUAGE plpgsql

-- COM ESTRUTURA IF
DO $$
DECLARE 
n INT :=  valor_aleatorio_entre(1,100);
n1 INT := valor_aleatorio_entre(1,100);
op INT := valor_aleatorio_entre(1,4);
res NUMERIC (5,2);

BEGIN
 RAISE NOTICE 'Primeiro valor gerado: %', n;
 RAISE NOTICE 'Primeiro valor gerado: %', n1;
 RAISE NOTICE 'Operação escolhida: %', op;

    IF op = 1 THEN
        res := soma(n,n1);
        RAISE NOTICE '% + % = %', n, n1, res;

    ELSIF op = 2 THEN
        res := subtracao(n,n1);
        RAISE NOTICE '% - % = %', n, n1, res;

    ELSIF op = 3 THEN
        res := multiplicacao(n,n1);
        RAISE NOTICE '% * % = %', n, n1, res;
     
        ELSE
        res := divisao(n,n1);
        RAISE NOTICE '% * % = %', n, n1, res;
    END IF;
END;
$$

-- COM ESTRUTURA CASE
DO $$
DECLARE
    op INTEGER := valor_aleatorio_entre(1, 4);
    n1 INTEGER := valor_aleatorio_entre(1, 10);
    n2 INTEGER := valor_aleatorio_entre(1, 10);
    resultado NUMERIC;
BEGIN    
    RAISE NOTICE 'Operação escolhida: %', op;
    CASE op
        WHEN 1 THEN
            resultado := n1 + n2;
            RAISE NOTICE '% + % = %', n1, n2, resultado;

        WHEN 2 THEN
            resultado := n1 - n2;
            RAISE NOTICE '% - % = %', n1, n2, resultado;

        WHEN 3 THEN
            resultado := n1 * n2;
            RAISE NOTICE '% * % = %', n1, n2, resultado;

        WHEN 4 THEN
            CASE
                WHEN n2 <> 0 THEN
                    resultado := n1 / n2;
                    RAISE NOTICE '% / % = %', n1, n2, resultado;
                ELSE
                    RAISE NOTICE 'Divisão por zero!';
            END CASE;
    END CASE;

END;
$$;


