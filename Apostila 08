DO $$
DECLARE
  n1 INT := random() + 1;
  raiz2 FLOAT;
  raiz3 FLOAT;
  antecessor FLOAT;
  sucessor FLOAT;
BEGIN
    antecessor := n1 - 1;
    sucessor := n1 + 1;
    RAISE NOTICE 'O número gerado foi %', n1;
    raiz2 := sqrt(sucessor);
    RAISE NOTICE 'A raiz quadrada do sucessor de % é a %', n1, raiz2;
    raiz3 := cbrt(antecessor);
    RAISE NOTICE 'A raiz cubica do antecessor de % é a %', n1,raiz3;
    END;
$$

